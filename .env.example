# Copy to .env. Read by `pnpm dev`, `pnpm start`, and the pnpm scripts; the server
# validates Worker settings with src/config.ts and the local PORT in src/index.ts.
# Generate secrets with: openssl rand -hex 32

# ── Worker settings ──

# Startup and Wrangler require CONVEX_INTERNAL_SECRET, IMAGE_PROXY_SECRET, REPO_CAPABILITY_SECRET
# and REPO_CONTENT_KEY in every environment.

# Convex URLs (optional at startup; needed for the full app).
# `pnpm exec convex dev` writes these to .env.local; copy them here.
# CONVEX_SITE_URL is derived from CONVEX_URL when unset.
CONVEX_URL=https://your-project.convex.cloud
CONVEX_SITE_URL=https://your-project.convex.site

# Authorizes Worker-to-Convex calls and signs auth client IPs (min 32 chars).
# Set the same value in Convex and the Worker:
#   pnpm exec convex env set CONVEX_INTERNAL_SECRET <value>
#   pnpm exec wrangler secret put CONVEX_INTERNAL_SECRET
CONVEX_INTERNAL_SECRET=replace-with-a-separate-real-secret

# Signs same-origin image proxy URLs (/img/<sig>/<url>) written at ingest (min 32 chars).
# Dedicated: never reuse another secret. The ingest Worker needs the same value.
# Rotating it requires a RENDERER_VERSION bump so stored renders are rebuilt.
#   pnpm exec wrangler secret put IMAGE_PROXY_SECRET
IMAGE_PROXY_SECRET=replace-with-a-dedicated-image-proxy-secret

# Signs repository capability cookies and asset tickets (/r/… docs; min 32 chars).
# Worker only, and never the same value as another secret:
#   pnpm exec wrangler secret put REPO_CAPABILITY_SECRET
REPO_CAPABILITY_SECRET=replace-with-a-third-separate-secret

# Seals private-repository content in R2 (per-repository AES-256-GCM keys; min 32 chars).
# Dedicated, never the same value as another secret; the ingest Worker needs the same value.
# To rotate: move the old value to REPO_CONTENT_KEY_PREVIOUS (on both Workers), set a new one,
# and remove the previous key once no content sealed under it remains (docs/TECHNICAL.md).
#   pnpm exec wrangler secret put REPO_CONTENT_KEY
REPO_CONTENT_KEY=replace-with-a-dedicated-content-key
# REPO_CONTENT_KEY_PREVIOUS=

# Convex-only auth settings (set with `pnpm exec convex env set`, not read from here):
# AUTH_SECRET=replace-with-a-real-secret
# SITE_URL=http://localhost:3000
# RESEND_API_KEY=re_xxx
# AUTH_EMAIL_FROM=Rendro <auth@rendro.app>

# ── server ──

# Only read by the local Node server, not the Worker.
PORT=3000
NODE_ENV=development
# Pino level; defaults to debug (info when NODE_ENV=production)
# LOG_LEVEL=debug
