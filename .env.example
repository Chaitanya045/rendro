# Copy to .env. Read by `pnpm dev`, `pnpm start`, and the pnpm scripts; the server
# validates Worker settings with src/config.ts and the local PORT in src/index.ts.
# Generate secrets with: openssl rand -hex 32

# ── Worker settings ──

# Startup and Wrangler require AUTH_SECRET, CONVEX_INTERNAL_SECRET,
# MINIO_ENDPOINT, MINIO_ACCESS_KEY, and MINIO_SECRET_KEY in every environment.

# Signs legacy /share/:token links (min 16 chars; 32+ recommended).
# Need not match the Convex AUTH_SECRET.
AUTH_SECRET=replace-with-a-real-secret

# Convex URLs (optional at startup; needed for the full app).
# `pnpm exec convex dev` writes these to .env.local; copy them here.
# CONVEX_SITE_URL is derived from CONVEX_URL when unset.
CONVEX_URL=https://your-project.convex.cloud
CONVEX_SITE_URL=https://your-project.convex.site

# Authorizes legacy Worker-to-Convex calls (min 32 chars). Set the same value in
# Convex and the Worker:
#   pnpm exec convex env set CONVEX_INTERNAL_SECRET <value>
#   pnpm exec wrangler secret put CONVEX_INTERNAL_SECRET
CONVEX_INTERNAL_SECRET=replace-with-a-separate-real-secret

# Convex-only auth settings (set with `pnpm exec convex env set`, not read from here):
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# SITE_URL=http://localhost:3000
# RESEND_API_KEY=re_xxx
# AUTH_EMAIL_FROM=Rendro <auth@rendro.app>

# Not read by the Worker. Set the same value in Convex.
# RETENTION_SECRET: `pnpm cleanup:retention` and GitHub Actions.
# MIGRATION_SECRET: `pnpm migrate:legacy --apply` only.
RETENTION_SECRET=replace-with-another-random-secret
MIGRATION_SECRET=replace-with-a-separate-migration-secret


# ── blob storage (S3-compatible) ──

# MinIO (local dev)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docs
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# R2 (production — set via `pnpm exec wrangler secret put`)
# MINIO_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=<R2 access key>
# MINIO_SECRET_KEY=<R2 secret key>
# MINIO_BUCKET=rendro-docs
# MINIO_REGION=auto
# MINIO_FORCE_PATH_STYLE=true

# ── server ──

# Only read by the local Node server, not the Worker.
PORT=3000
NODE_ENV=development
# Pino level; defaults to debug (info when NODE_ENV=production)
# LOG_LEVEL=debug

# ── optional tooling ──

# Target Worker for `pnpm migrate:legacy` (default http://localhost:3000)
# RENDRO_ENDPOINT=http://localhost:3000
# CLI credential for `rendro push` / `rendro publication` (rnd_live_<keyId>_<secret>).
# The CLI reads it from the shell environment, not from this file.
# RENDRO_API_KEY=rnd_live_xxx
