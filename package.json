{
  "name": "rendro",
  "version": "2.0.0",
  "description": "CLI to deploy and publish project-scoped HTML documentation to Rendro. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaitanya045/rendro.git",
    "directory": "."
  },
  "homepage": "https://rendro.app",
  "keywords": [
    "docs",
    "documentation",
    "sync",
    "cli",
    "rendro"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "bin": {
    "rendro": "bin/rendro.mjs"
  },
  "files": [
    "bin/rendro.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:assets && git diff --check && pnpm verify:assets",
    "verify:assets": "git diff --exit-code -- public/management-query.js public/select.js public/management-pages.js",
    "build:assets": "tsx scripts/build-private-viewer.ts && tsx scripts/build-commentor.ts && tsx scripts/build-commentor-parent.ts && tsx scripts/build-lazy-tree.ts && tsx scripts/build-management-query.ts && tsx scripts/build-select.ts && tsx scripts/build-management-pages.ts",
    "cli": "tsx cli/src/index.ts",
    "cli:build": "node scripts/build-cli.mjs",
    "prepack": "node scripts/build-cli.mjs",
    "init:minio": "tsx --env-file=.env scripts/init-minio.ts",
    "migrate:legacy": "tsx --env-file-if-exists=.env scripts/migrate-legacy-tenancy.ts",
    "cleanup:retention": "tsx --env-file-if-exists=.env scripts/cleanup-retention.ts",
    "deploy": "pnpm build:assets && wrangler deploy --config wrangler.toml"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/memory-adapter": "^1.6.23",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "0.3.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.1",
    "@tanstack/query-core": "^5.102.8",
    "@tanstack/query-persist-client-core": "5.102.8",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-auth": "^1.6.23",
    "convex": "^1.42.0",
    "convex-test": "^0.0.54",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "happy-dom": "^20.14.5",
    "hono": "^4.13.8",
    "jose": "^6.2.3",
    "parse5": "8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.64.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0",
    "zod": "^4.4.3"
  }
}
