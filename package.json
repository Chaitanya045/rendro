{
  "name": "rendro",
  "version": "2.0.0",
  "description": "CLI to deploy and publish project-scoped HTML documentation to Rendro. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaitanya045/rendro.git",
    "directory": "."
  },
  "homepage": "https://rendro.app",
  "keywords": [
    "docs",
    "documentation",
    "sync",
    "cli",
    "rendro"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "bin": {
    "rendro": "bin/rendro.mjs"
  },
  "files": [
    "bin/rendro.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "verify:convex": "vitest run --project unit tests/convex-codegen.test.ts",
    "verify:convex:generated": "convex codegen && git diff --exit-code -- convex/_generated convex/betterAuth/_generated",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "tsx tests/helpers/run-browser-coverage.ts",
    "verify": "pnpm typecheck && pnpm typecheck:convex && pnpm lint && pnpm verify:fonts && pnpm verify:styles && pnpm verify:wasm && pnpm test && pnpm build:assets && git diff --check && pnpm verify:assets",
    "record:assets": "tsx scripts/verify-asset-versions.ts --record",
    "verify:assets": "tsx scripts/verify-asset-versions.ts && git diff --exit-code -- public/management-query.js public/select.js public/management-pages.js",
    "build:fonts": "tsx scripts/build-fonts.ts",
    "verify:fonts": "tsx scripts/build-fonts.ts --check",
    "build:styles": "tsx scripts/build-styles.ts",
    "verify:styles": "tsx scripts/build-styles.ts --check",
    "verify:wasm": "tsx scripts/verify-comrak-wasm.ts",
    "rebuild:wasm": "tsx scripts/verify-comrak-wasm.ts --rebuild",
    "build:wasm": "tsx scripts/verify-comrak-wasm.ts --write",
    "bench:hostile": "tsx scripts/benchmark-hostile-input.ts",
    "build:assets": "tsx scripts/build-private-viewer.ts && tsx scripts/build-commentor.ts && tsx scripts/build-commentor-parent.ts && tsx scripts/build-lazy-tree.ts && tsx scripts/build-rum.ts && tsx scripts/build-management-query.ts && tsx scripts/build-select.ts && tsx scripts/build-management-pages.ts",
    "cli": "tsx cli/src/index.ts",
    "cli:build": "node scripts/build-cli.mjs",
    "prepack": "node scripts/build-cli.mjs",
    "migrate:legacy": "tsx --env-file-if-exists=.env scripts/migrate-legacy-tenancy.ts",
    "visual": "bash scripts/visual-baselines.sh check",
    "a11y": "RENDRO_E2E_VISUAL=1 playwright test --config e2e/visual.config.ts --project=a11y-chromium --project=a11y-firefox --project=a11y-webkit",
    "visual:update": "bash scripts/visual-baselines.sh update",
    "check:r2-public": "tsx scripts/check-r2-public-access.ts",
    "deploy": "pnpm build:assets && wrangler deploy --config wrangler.toml",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@axe-core/playwright": "^4.13.0",
    "@bcoe/v8-coverage": "1.0.2",
    "@better-auth/memory-adapter": "^1.6.23",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "0.3.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "^2.1.1",
    "@playwright/test": "1.64.0",
    "@tanstack/query-core": "^5.102.8",
    "@tanstack/query-persist-client-core": "5.102.8",
    "@types/fontkit": "2.0.9",
    "@types/hast": "3.0.5",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ast-v8-to-istanbul": "1.0.7",
    "better-auth": "^1.6.23",
    "better-call": "1.3.7",
    "convex": "^1.42.0",
    "convex-test": "^0.0.54",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "fontkit": "2.0.4",
    "github-slugger": "2.0.0",
    "happy-dom": "^20.14.5",
    "hast-util-from-parse5": "8.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "highlight.js": "11.11.2",
    "hono": "^4.13.8",
    "istanbul-lib-coverage": "3.2.2",
    "jose": "^6.2.3",
    "lowlight": "3.3.0",
    "material-symbols": "0.48.0",
    "parse5": "8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.64.0",
    "subset-font": "2.9.0",
    "tinyglobby": "0.2.17",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11",
    "web-vitals": "6.2.3",
    "wrangler": "^4.149.0",
    "zod": "^4.4.3"
  }
}
